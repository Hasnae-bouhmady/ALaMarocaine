pipeline {
  agent any
  options {
    buildDiscarder(logRotator(numToKeepStr: '5'))
  }
tools { maven 'maven-alamarocaine' }
  stages {
    stage('Scan') {
      steps {
        dir('Backend/bin') {
          withSonarQubeEnv('sq1') {
            
           sh 'mvn clean verify org.sonarsource.scanner.maven:sonar-maven-plugin:3.9.0.2155:sonar'
          }
        }
      }
    }
  }
}
