pipeline {
  agent any
  options {
    buildDiscarder(logRotator(numToKeepStr: '5'))
  }
tools { maven 'maven-alamarocaine' }
  stages {
    stage('Scan') {
      steps {
        dir('Backend/bin') {
          withSonarQubeEnv('sq1') {
            sh 'mvnw clean verify sonar:sonar'
          }
        }
      }
    }
  }
}
