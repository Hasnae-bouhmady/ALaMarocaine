pipeline {
  agent any
  options {
    buildDiscarder(logRotator(numToKeepStr: '5'))
  }
  environment {
    scannerHome = tool 'SonarScanner'
  }
  stages {
    stage('Scan') {
      steps {
        dir('Frontend') {
          withSonarQubeEnv(installationName: 'sq1') {
            sh "${scannerHome}/bin/sonar-scanner"
          }
        }
      }
    }
  }
}
